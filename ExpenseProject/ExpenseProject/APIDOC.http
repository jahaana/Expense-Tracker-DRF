# API call for list all expenses
###
GET http://127.0.0.1:8000/expenses/
Authorization: Basic YOUR_BASE64_TOKEN

# API call for create expense
###
POST http://127.0.0.1:8000/expenses/
Authorization: Basic YOUR_BASE64_TOKEN
Content-Type: application/json

{
    "title": "Lunch",
    "amount": "150.00",
    "category": "food",
    "payment": "UPI"
}

# API call for view expense details
###
GET http://127.0.0.1:8000/expenses/1/
Authorization: Basic YOUR_BASE64_TOKEN

# API call for update expense data
###
PUT http://127.0.0.1:8000/expenses/1/
Authorization: Basic YOUR_BASE64_TOKEN
Content-Type: application/json

{
    "title": "Dinner",
    "amount": "250.00",
    "category": "food",
    "payment": "card"
}

# API call for partial updation of expense data
###
PATCH http://127.0.0.1:8000/expenses/1/
Authorization: Basic YOUR_BASE64_TOKEN
Content-Type: application/json

{
    "amount": "200.00"
}


# API call for delete expense
###
DELETE http://127.0.0.1:8000/expenses/1/
Authorization: Basic YOUR_BASE64_TOKEN

# API call for filter by category and payment method
###
GET http://127.0.0.1:8000/expenses/?category=food
Authorization: Basic YOUR_BASE64_TOKEN

###
GET http://127.0.0.1:8000/expenses/?payment=UPI
Authorization: Basic YOUR_BASE64_TOKEN

# API call for search by expense title
###
GET http://127.0.0.1:8000/expenses/?search=lunch
Authorization: Basic base64-user-password

API call for order by created date
###
GET http://127.0.0.1:8000/expenses/?ordering=created_at